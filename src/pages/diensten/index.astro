---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/wrapper/Section.astro';
import ContentWrapper from '@/components/wrapper/ContentWrapper.astro';
import Heading from '@/components/typography/Heading.astro';
import Paragraph from '@/components/typography/Paragraph.astro';
import Eyebrow from '@/components/typography/Eyebrow.astro';
import ServiceCard from '@/components/cards/ServiceCard.astro';
import CtaSection from '@/components/sections/CtaSection.astro';
import { getServices } from '@/lib/services';

const services = await getServices();
---

<BaseLayout
    title="Diensten | GorillaMade"
    description="Webdesign, webdevelopment, hosting, onderhoud en lokale SEO. Ontdek wat GorillaMade voor jouw bedrijf kan betekenen."
>
    <Section theme="light" class="services-page">
        <ContentWrapper size="wide">
            <header class="services-intro">
                <div class="services-intro__heading">
                    <Eyebrow>01 / WAT IK DOE</Eyebrow>
                    <Heading tag="h1" variant="h1">
                        DIGITAAL WERK. <span class="highlight">GOED GEDAAN.</span>
                    </Heading>
                </div>
                <div class="services-intro__aside">
                    <Paragraph>
                        Van eerste idee tot een website die voor je werkt.
                        Ontwerp, techniek en onderhoud, direct geregeld met één aanspreekpunt.
                    </Paragraph>
                    <span class="services-intro__count">
                        {String(services.length).padStart(2, '0')} DIENSTEN
                    </span>
                </div>
            </header>

            <div class="grid services-grid">
                {services.map((service, index) => (
                    <ServiceCard
                        href={`/diensten/${service.id}/`}
                        title={service.data.title}
                        summary={service.data.summary}
                        tag={service.data.tag}
                        icon={service.data.icon}
                        index={index}
                        total={services.length}
                    />
                ))}
            </div>
        </ContentWrapper>
    </Section>

    <CtaSection
        eyebrow="JOUW PROJECT"
        title="KLAAR VOOR"
        accent="DE VOLGENDE STAP?"
        description="Vertel me waar je aan werkt. Dan bekijken we wat je nodig hebt."
        buttonLabel="Vraag een offerte aan ↗"
        buttonHref="/offerte"
        theme="dark"
        showBottom={false}
    />
</BaseLayout>

<style lang="scss">
    .services-intro {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: clamp(2rem, 5vw, 5rem);
        margin-bottom: clamp(2.5rem, 5vw, 4.5rem);

        &__heading { flex: 1 1 auto; min-width: 0; }
        &__heading :global(h1) {
            max-width: 13ch;
            margin: 1.25rem 0 0;
            line-height: 1.02;
            letter-spacing: -.07em;
        }
        &__aside {
            display: flex;
            flex: 0 1 340px;
            flex-direction: column;
            align-items: flex-start;
            gap: 1.5rem;
            padding-bottom: .35rem;
        }
        &__aside :global(p) {
            max-width: 34ch;
            margin: 0;
            color: var(--text-secondary);
            line-height: 1.75;
        }
        &__count {
            color: var(--text-secondary);
            font-size: .6875rem;
            font-weight: 700;
            letter-spacing: .16em;
        }
    }

    .services-grid {
        --grid-placement: auto-fit;
        --grid-min-item-size: 27rem;
        --grid-gap: clamp(1rem, 2vw, 1.5rem);
    }

    @media (width < 700px) {
        .services-intro { flex-direction: column; align-items: flex-start; gap: 1.5rem; }
        .services-intro__aside { flex: none; width: 100%; gap: 1rem; }

    }
</style>
