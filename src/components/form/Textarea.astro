
---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'textarea'> {
    id: string;
    label: string;
    description?: string;
}

const {
    id,
    label,
    description,
    required,
    class: className,
    ...attrs
} = Astro.props;

const descriptionId = `${id}-description`;
---

<label class:list={['field', className]} for={id}>
    <span>{label}</span>

    <textarea
        id={id}
        name={attrs.name ?? id}
        aria-describedby={description ? descriptionId : undefined}
        {...attrs}
        required={required}
    ></textarea>

    {required && <span class="field__error">Vul dit veld in.</span>}

    {description && (
        <span
            id={descriptionId}
            class="field__description"
        >
            {description}
        </span>
    )}
</label>

<style lang="scss">
.field {
    display: grid;
    gap: var(--space-xs);
}

.field textarea {
    width: 100%;
    padding: var(--space-s);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-s);
    background: var(--surface-page);
    color: var(--text-primary);
}

.field__description {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
}
</style>
