---
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'textarea'> { id:string; label:string; }
const {id,label,class:className,...attrs}=Astro.props;
---
<label class:list={['field',className]} for={id}><span>{label}</span><textarea id={id} name={attrs.name ?? id} {...attrs}></textarea></label>
<style lang="scss">
.field{
    display:grid;
    gap:var(--space-xs)}

.field textarea{
    width:100%;
    padding:var(--space-s);
    border:1px solid var(--border-default);
    border-radius:var(--radius-s);
    background:var(--surface-page);
    color:var(--text-primary)}
</style>
