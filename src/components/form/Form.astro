---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'form'> {}

const { class: className, ...attrs } = Astro.props;
---

<form class:list={['form', className]} {...attrs}>
    <slot />
</form>

<style lang="scss">
.form {
    display: grid;
    gap: var(--space-m);
}
</style>
