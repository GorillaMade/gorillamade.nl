
---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'select'> {
  /** Unique select ID. */
  id: string;

  /** Visible label. */
  label: string;

  /** Visually hide the label. */
  labelHidden?: boolean;

  /** Optional helper text. */
  description?: string;

  /** Set to false to omit the component. */
  render?: boolean;
}

const {
  id,
  label,
  labelHidden = false,
  description,
  render = true,
  class: className,
  name,
  'aria-describedby': ariaDescribedby,
  ...rest
} = Astro.props;

// --------------------------------------------------
// Description
// --------------------------------------------------

const descriptionId = `${id}-description`;

const describedBy = [
  ariaDescribedby,
  description ? descriptionId : undefined
]
  .filter(Boolean)
  .join(' ') || undefined;
---

{render && (
  <div
    class:list={[
      'field',
      className
    ]}
  >
    <label
      for={id}
      class:list={[
        'field__label',
        labelHidden && 'visually-hidden'
      ]}
    >
      {label}
    </label>

    <div class="field__select-wrapper">
      <select
        {...rest}
        id={id}
        name={name ?? id}
        class="field__select"
        aria-describedby={describedBy}
      >
        <slot />
      </select>

      <svg
        class="field__icon"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m6 9 6 6 6-6" />
      </svg>
    </div>

    {description && (
      <span
        id={descriptionId}
        class="field__description"
      >
        {description}
      </span>
    )}
  </div>
)}

<style lang="scss">
.field {
    // Configuration
    --field-gap: var(--space-xs);
    --field-padding-block: var(--space-s);
    --field-padding-inline: var(--space-m);
    // Base
    display: flex;
    flex-direction: column;
    gap: var(--field-gap);
    width: 100%;
    min-width: 0;
    color: var(--text-primary);
    // Label
    &__label {
        display: block;
        font-size: var(--text-small);
        font-weight: var(--fw-strong);
        line-height: 1.4;
        cursor: pointer;
    }
    // Select wrapper
    &__select-wrapper {
        position: relative;
        width: 100%;
        min-width: 0;
    }
    // Select
    &__select {
        display: block;
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
        padding:
        var(--field-padding-block)
        calc(var(--field-padding-inline) + 1.5rem)
        var(--field-padding-block)
        var(--field-padding-inline);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-m);
        background-color: var(--surface-page);
        color: var(--text-primary);
        font: inherit;
        line-height: 1.5;
        appearance: none;
        cursor: pointer;
        outline: none;
        transition:
        border-color var(--duration-fast),
        box-shadow var(--duration-fast),
        background-color var(--duration-fast);
        // Hover
        @media (hover: hover) {
            &:hover:not(:disabled) {
                border-color: var(--text-primary);
            }
        }
        // Focus
        &:focus-visible {
            border-color: var(--focus-color);
            box-shadow: 0 0 0 2px var(--focus-color);
        }
        // Invalid
        &[aria-invalid='true'] {
            border-color: var(--field-error-color, var(--text-brand));
            &:focus-visible {
                box-shadow:
                0 0 0 2px var(--field-error-color, var(--text-brand));
            }
        }
        // Disabled
        &:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            background-color: var(--surface-subtle);
        }
    }
    // Icon
    &__icon {
        position: absolute;
        top: 50%;
        right: var(--field-padding-inline);
        width: 1.25rem;
        height: 1.25rem;
        transform: translateY(-50%);
        color: var(--text-primary);
        pointer-events: none;
    }
    // Description
    &__description {
        font-size: var(--text-small);
        line-height: 1.5;
        color: var(--text-primary);
        opacity: 0.65;
    }
    // Disabled
    &:has(.field__select:disabled) {
        .field__label,
        .field__icon {
            opacity: 0.5;
        }

        .field__label {
            cursor: not-allowed;
        }
    }
}
// Visually hidden
.visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}
// Reduced motion
@media (prefers-reduced-motion: reduce) {
    .field__select {
        transition: none;
    }
}
</style>
