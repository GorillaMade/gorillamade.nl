
---
import { getCollection } from 'astro:content';

import Section from '@/components/wrapper/Section.astro';
import ContentWrapper from '@/components/wrapper/ContentWrapper.astro';
import Heading from '@/components/typography/Heading.astro';
import Paragraph from '@/components/typography/Paragraph.astro';
import Eyebrow from '@/components/typography/Eyebrow.astro';
import Button from '@/components/Button.astro';
import BrowserFrame from '@/components/showcase/BrowserFrame.astro';

const projects = (await getCollection('showcases'))
    .filter((item) => item.data.featured && item.data.cover);
---

<Section theme="dark" class="minimal-hero">
    <ContentWrapper size="wide">
        <div class="hero-grid">
            <div class="hero-copy flow">
                <Eyebrow>
                    WEBDESIGN & DEVELOPMENT / GORILLAMADE®
                </Eyebrow>

                <Heading tag="h1" variant="display">
                    Een website die
                    <span class="highlight">lokale groei</span>
                    aanjaagt.
                </Heading>

                <Paragraph>
                    Premium websites voor Tilburgse ondernemers die meer
                    klanten, meer zichtbaarheid en minder gedoe willen.
                </Paragraph>

                <div class="hero-actions">
                    <Button href="/offerte/">
                        Bespreek jouw project ↗
                    </Button>

                    <Button href="#selected-work" emphasis="secondary">
                        Bekijk mijn werk ↗
                    </Button>
                </div>

                <p class="hero-signature">
                    Eén aanspreekpunt. Van eerste idee tot livegang.
                </p>
            </div>

            {projects.length > 0 && (
                <div class="hero-showcases" data-random-showcase>
                    {projects.map((project, index) => (
                        <div
                            class="hero-showcases__item"
                            data-showcase
                            hidden={index !== 0}
                        >
                            <BrowserFrame
                                image={project.data.cover}
                                title={project.data.title}
                                href={`/showcases/${project.id}/`}
                                label="UITGELICHT WERK"
                            />
                        </div>
                    ))}
                </div>
            )}
        </div>

        <div class="hero-values" aria-label="Mijn aanpak">
            <span>
                <b>01</b>
                Strategie
                <small>Een helder plan.</small>
            </span>

            <span>
                <b>02</b>
                Ontwerp
                <small>Design met karakter.</small>
            </span>

            <span>
                <b>03</b>
                Development
                <small>Snel en schaalbaar.</small>
            </span>

            <span>
                <b>04</b>
                Onderhoud
                <small>Ook na livegang.</small>
            </span>
        </div>
    </ContentWrapper>
</Section>

<script>
    function initRandomShowcase() {
        document.querySelectorAll<HTMLElement>('[data-random-showcase]').forEach((container) => {
            const showcases = Array.from(
                container.querySelectorAll<HTMLElement>('[data-showcase]')
            );

            if (showcases.length <= 1) return;

            const randomIndex = Math.floor(Math.random() * showcases.length);

            showcases.forEach((showcase, index) => {
                showcase.hidden = index !== randomIndex;
            });
        });
    }

    document.addEventListener('astro:page-load', initRandomShowcase);

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initRandomShowcase, {
            once: true
        });
    } else {
        initRandomShowcase();
    }
</script>

<style lang="scss">
.minimal-hero {
    padding-block: clamp(3rem, 7vw, 7rem) 2rem;
}

.hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2rem, 5vw, 6rem);
    align-items: center;
}

.hero-copy {
    :global(h1) {
        max-width: 12ch;
        margin: 1.5rem 0;
        line-height: 0.94;
        letter-spacing: -0.065em;
    }

    :global(p) {
        max-width: 52ch;
        line-height: 1.75;
        color: var(--text-secondary);
    }
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
}

.hero-signature {
    margin-top: 1.7rem;
    font-size: 0.78rem;
}

.hero-showcases {
    min-width: 0;
}

.hero-showcases__item {
    min-width: 0;

    &[hidden] {
        display: none !important;
    }
}

.hero-values {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(3rem, 6vw, 6rem);
    border-top: 1px solid var(--border-default);

    span {
        display: grid;
        grid-template-columns: auto 1fr;
        column-gap: 1rem;
        padding: 1.4rem 1rem;
        border-right: 1px solid var(--border-default);
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;

        &:last-child {
            border-right: 0;
        }
    }

    b {
        font-size: 1.3rem;
        font-weight: 500;
    }

    small {
        grid-column: 2;
        color: var(--text-secondary);
        font-weight: 400;
        text-transform: none;
    }
}

@media (max-width: 900px) {
    .hero-grid {
        grid-template-columns: 1fr;
    }

    .hero-values {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 500px) {
    .hero-values span {
        padding: 1rem 0.5rem;
        column-gap: 0.5rem;
    }
}


.browser-frame__screen img {
    object-fit: contain;
}
</style>
