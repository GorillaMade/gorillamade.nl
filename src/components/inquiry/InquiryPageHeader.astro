
---
interface Props {
    index: string;
    eyebrow: string;
}

const { index, eyebrow } = Astro.props;
---

<header class="inquiry-head">
    <div class="meta">
        <span>{index} / GORILLAMADE</span>
        <span>{eyebrow}</span>
    </div>

    <div class="inquiry-head__content">
        <slot />
    </div>
</header>

<style lang="scss">
.inquiry-head {
    padding-block-end: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--border-default);
}

.meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .14em;
    color: var(--text-secondary);
    text-transform: uppercase;
}

.inquiry-head__content {
    :global(h1) {
        max-width: 14ch;
        letter-spacing: -.075em;
        line-height: 1;
        margin: clamp(2rem, 4vw, 3rem) 0 1.5rem;
    }

    :global(p) {
        max-width: 60ch;
        color: var(--text-secondary);
        line-height: 1.65;
    }
}
</style>
