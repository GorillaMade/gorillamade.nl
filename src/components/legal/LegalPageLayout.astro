
---
import Section from '@/components/wrapper/Section.astro';
import ContentWrapper from '@/components/wrapper/ContentWrapper.astro';
import Heading from '@/components/typography/Heading.astro';
import Paragraph from '@/components/typography/Paragraph.astro';

interface Props {
    index: string;
    eyebrow: string;
    title: string;
    description: string;
}

const { index, eyebrow, title, description } = Astro.props;
---

<Section theme="light" class="legal-page">
    <ContentWrapper size="wide">
        <header class="legal-header">
            <div class="legal-header__meta">
                <span>{index} / GORILLAMADE</span>
                <span>{eyebrow}</span>
            </div>

            <Heading tag="h1" variant="display">
                {title}<span class="highlight">.</span>
            </Heading>

            <Paragraph>{description}</Paragraph>
        </header>

        <div class="legal-layout">
            <aside class="legal-aside">
                <span class="eyebrow">INFORMATIE & VOORWAARDEN</span>
                <span class="legal-index">{index}</span>
            </aside>

            <article class="legal-copy">
                <slot />
            </article>
        </div>
    </ContentWrapper>
</Section>

<style lang="scss">
.legal-page {
    color: var(--text-primary);
}

.legal-header {
    padding-block-end: clamp(3rem, 8vw, 7rem);
    border-bottom: 1px solid var(--border-default);
}

.legal-header__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--text-secondary);
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
}

.legal-header {
    :global(h1) {
        max-width: 16ch;
        margin: clamp(2rem, 5vw, 4rem) 0 1.5rem;
        line-height: 1;
        letter-spacing: -.075em;
        overflow-wrap: anywhere;
    }

    :global(p) {
        max-width: 60ch;
        color: var(--text-secondary);
        line-height: 1.7;
    }
}

.legal-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: clamp(4rem, 8vw, 8rem);
}

.legal-aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
}

.eyebrow {
    color: var(--text-secondary);
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .14em;
}

.legal-index {
    color: var(--text-secondary);
    font-size: clamp(4rem, 9vw, 9rem);
    font-weight: 700;
    letter-spacing: -.08em;
    line-height: .9;
    opacity: .2;
}

.legal-copy {
    min-width: 0;
    max-width: 48rem;
    overflow-wrap: break-word;

    // De Markdown-inhoud wordt door een andere component
    // gerenderd. Daarom gebruiken we :global().

    :global(h1) {
        margin: 0 0 2rem;
        color: var(--text-primary);
        font-size: clamp(1.5rem, 2.5vw, 2rem);
        letter-spacing: -.04em;
        line-height: 1.3;
    }

    :global(h2) {
        margin: 3.5rem 0 1.25rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border-default);
        color: var(--text-primary);
        font-size: clamp(1.25rem, 2vw, 1.75rem);
        font-weight: 700;
        letter-spacing: -.04em;
        line-height: 1.3;
    }

    :global(h2:first-child) {
        margin-top: 0;
        padding-top: 0;
        border-top: 0;
    }

    :global(p) {
        margin: 0 0 1.25rem;
        color: var(--text-secondary);
        font-size: 1rem;
        line-height: 1.85;
    }

    :global(strong) {
        color: var(--text-primary);
        font-weight: 700;
    }

    :global(ul),
    :global(ol) {
        margin: 1.5rem 0 2rem;
        padding-left: 1.5rem;
        color: var(--text-secondary);
    }

    :global(li) {
        margin-bottom: .75rem;
        line-height: 1.75;
    }

    :global(a) {
        color: var(--text-primary);
        text-decoration: underline;
        text-underline-offset: .25em;
        transition: opacity .2s ease;
    }

    :global(a:hover) {
        opacity: .65;
    }

    :global(hr) {
        margin: 3rem 0;
        border: 0;
        border-top: 1px solid var(--border-default);
    }

    :global(code) {
        font-family: inherit;
        font-size: inherit;
        overflow-wrap: anywhere;
    }
}

@media (max-width: 720px) {
    .legal-layout {
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    .legal-aside {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .legal-index {
        font-size: 4rem;
    }
}

@media (prefers-reduced-motion: reduce) {
    .legal-copy :global(a) {
        transition: none;
    }
}
</style>
