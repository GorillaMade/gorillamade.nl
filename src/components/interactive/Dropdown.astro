
---
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'details'>, 'open'> & {
  render?: boolean;
  label: string;
  preview?: boolean;
};

const {
  render = true,
  label,
  preview = false,
  class: className,
  ...rest
} = Astro.props;
---

{render && (
  <details
    {...rest}
    x-data="{}"
    @click.outside="if ($el.open) $el.open = false"
    @keydown.escape.window="if ($el.open) { $el.open = false; $el.querySelector('summary')?.focus(); }"
    class:list={[
      'dropdown',
      preview && 'dropdown--preview',
      className
    ]}
    open={preview || undefined}
  >
    <summary class="dropdown__toggle">
      <span class="dropdown__label">
        {label}
      </span>

      <svg
        class="dropdown__icon"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m9 18 6-6-6-6" />
      </svg>
    </summary>

    <div class="dropdown__panel">
      <div class="dropdown__body">
        <slot />
      </div>
    </div>
  </details>
)}

<style lang="scss">
.dropdown {
    // Configuration
    --_dropdown-padding: var(
    --dropdown-padding,
    var(--space-xs)
    );
    --_dropdown-offset: var(
    --dropdown-offset,
    var(--space-xs)
    );
    --_dropdown-min-width: var(
    --dropdown-min-width,
    14rem
    );
    --_dropdown-max-width: var(
    --dropdown-max-width,
    22rem
    );
    // Base
    position: relative;
    display: inline-block;
    width: max-content;
    max-width: 100%;
    color: var(--text-primary);
    // Toggle — Button secondary
    &__toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5em;
        width: max-content;
        max-width: 100%;
        min-height: 2.75rem;
        padding: 0.7em 1.1em;
        border: 1px solid currentColor;
        border-radius: var(--radius-m);
        background-color: transparent;
        color: var(--text-primary);
        font: inherit;
        font-weight: var(--fw-strong);
        line-height: 1.2;
        list-style: none;
        cursor: pointer;
        user-select: none;
        transition:
        background-color var(--duration-fast),
        color var(--duration-fast),
        border-color var(--duration-fast);
        &::marker {
            content: '';
        }

        &::-webkit-details-marker {
            display: none;
        }

        &:focus-visible {
            outline: 2px solid var(--focus-color);
            outline-offset: 3px;
        }
    }
    // Label
    &__label {
        display: block;
        min-width: 0;
    }
    // Icon
    &__icon {
        display: block;
        flex: none;
        width: 1rem;
        height: 1rem;
        transform: rotate(90deg);
        transition:
        transform var(--duration-fast) ease;
    }
    // Panel
    &__panel {
        position: absolute;
        z-index: 20;
        top: calc(100% + var(--_dropdown-offset));
        inset-inline-start: 0;
        width: var(--_dropdown-min-width);
        max-width: min(
        var(--_dropdown-max-width),
        calc(100vw - var(--space-l) * 2)
        );
        box-sizing: border-box;
        border: 1px solid var(--border-default);
        border-radius: var(--radius-m);
        background-color: var(--surface-page);
        color: var(--text-primary);
        box-shadow:
        0 0.5rem 1.5rem rgb(0 0 0 / 0.12);
        transform: translateY(-0.5rem) scale(0.98);
        transform-origin: top left;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition:
        transform var(--duration-fast) ease,
        opacity var(--duration-fast) ease,
        visibility var(--duration-fast) ease;
    }
    // Body
    &__body {
        padding: var(--_dropdown-padding);
        // Navigation layout
        :global(.nav) {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: var(--space-xs);
            width: 100%;
            min-width: 0;
        }
        // Dropdown link layout
        :global(.nav-link) {
            display: flex;
            align-items: center;
            width: 100%;
            box-sizing: border-box;
            padding: var(--space-xs) var(--space-s);
            border-radius: var(--radius-s);
            text-decoration: none;
        }
        // Remove default link underline
        :global(.nav-link::before),
        :global(.nav-link::after) {
            display: none;
        }
        // Dropdown hover
        @media (hover: hover) {
            :global(.nav-link:hover) {
                background-color: var(--surface-subtle);
            }
        }
        // Active link
        :global(.nav-link[aria-current='page']) {
            background-color: var(--surface-subtle);
            font-weight: var(--fw-strong);
        }
    }
    // Open state
    &[open],
    &--preview {
        > .dropdown__toggle .dropdown__icon {
            transform: rotate(-90deg);
        }

        > .dropdown__panel {
            transform: translateY(0) scale(1);
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
        }
    }
    // Hover — Button secondary
    @media (hover: hover) {
        > .dropdown__toggle:hover {
            background-color: var(--button-hover-background);
            color: var(--button-hover-text);
            border-color: var(--button-hover-background);
        }
    }
}
// Reduced motion
@media (prefers-reduced-motion: reduce) {
    .dropdown {
        &__toggle,
        &__icon,
        &__panel {
            transition: none;
        }
    }
}
</style>
