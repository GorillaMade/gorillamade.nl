
---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'details'> & {
  /** Accordion title. */
  title: string;

  /** Whether the item is initially open. */
  open?: boolean;

  /** Set to false to omit the component. */
  render?: boolean;
};

const {
  title,
  open = false,
  render = true,
  class: className,
  ...rest
} = Astro.props;
---

{render && (
  <details
    {...rest}
    class:list={[
      'accordion-item',
      className
    ]}
    open={open}
    name="accordion-item"
  >
    <summary class="accordion-item__toggle">
      <span class="accordion-item__title">
        {title}
      </span>

      <span
        class="accordion-item__icon"
        aria-hidden="true"
      >
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
        >
          <path d="M5 12h14" />
          <path
            class="accordion-item__icon-vertical"
            d="M12 5v14"
          />
        </svg>
      </span>
    </summary>

    <div class="accordion-item__content">
      <div class="accordion-item__body">
        <slot />
      </div>
    </div>
  </details>
)}

<style lang="scss">
.accordion-item {
    // Configuration
    --accordion-padding: var(--space-m);
    --accordion-gap: var(--space-m);
    --accordion-icon-size: 2.5rem;
    // Base
    width: 100%;
    min-width: 0;
    border: 0;
    border-bottom: 1px solid var(--border-default);
    background-color: transparent;
    color: var(--text-primary);
    // Toggle
    &__toggle {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--accordion-gap);
        padding-block: var(--accordion-padding);
        list-style: none;
        cursor: pointer;
        user-select: none;
        &::marker {
            content: '';
        }

        &::-webkit-details-marker {
            display: none;
        }

        &:focus-visible {
            outline: 2px solid var(--focus-color);
            outline-offset: 3px;
            border-radius: var(--radius-s);
        }
    }
    // Title
    &__title {
        flex: 1;
        min-width: 0;
        font-size: inherit;
        font-weight: var(--fw-strong);
        line-height: 1.4;
        transition:
        opacity var(--duration-fast);
    }
    // Icon
    &__icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: none;
        width: var(--accordion-icon-size);
        height: var(--accordion-icon-size);
        border: 1px solid var(--border-default);
        border-radius: 50%;
        color: var(--text-primary);
        transition:
        background-color var(--duration-fast),
        color var(--duration-fast),
        border-color var(--duration-fast);
        svg {
            display: block;
            width: 1.25rem;
            height: 1.25rem;
        }
    }

    &__icon-vertical {
        transform-origin: center;
        transition:
        transform var(--duration-fast),
        opacity var(--duration-fast);
    }
    // Content
    &__content {
        min-width: 0;
    }

    &__body {
        padding-bottom: var(--space-l);
        padding-right: calc(
        var(--accordion-icon-size) + var(--accordion-gap)
        );
        line-height: 1.6;
        > :first-child {
            margin-top: 0;
        }

        > :last-child {
            margin-bottom: 0;
        }
    }
    // Hover
    @media (hover: hover) {
        &__toggle:hover {
            .accordion-item__title {
                opacity: 0.7;
            }

            .accordion-item__icon {
                background-color: var(--button-hover-background);
                color: var(--button-hover-text);
                border-color: var(--button-hover-background);
            }
        }
    }
    // Open state
    &[open] {
        .accordion-item__icon-vertical {
            transform: rotate(90deg);
            opacity: 0;
        }
    }
}
// Reduced motion
@media (prefers-reduced-motion: reduce) {
    .accordion-item {
        &__title,
        &__icon,
        &__icon-vertical {
            transition: none;
        }
    }
}
</style>
