---
interface Props { class?: string; label?: string; render?: boolean }
const {class:className,label,render=true}=Astro.props;
---
{render &&
    <span
        class:list={['icon',className]}
        role={label ? 'img' : undefined}
        aria-label={label}
        aria-hidden={label ? undefined : 'true'}
    >
        <slot />
    </span>
}
<style lang="scss">
.icon{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:2.5rem;
    height:2.5rem;
    border-radius:var(--radius-full);
    background:var(--surface-emphasis)}
</style>
