
---
import { Image } from 'astro:assets';
import profielfoto from '@/assets/images/profielfoto.png';

interface Props {
    alt?: string;
    caption?: string;
    eager?: boolean;
}

const {
    alt = 'Zakelijk portret van de maker achter GorillaMade',
    caption = 'DE MAKER ACHTER GORILLAMADE',
    eager = false,
} = Astro.props;
---

<figure class="portrait">
    <div class="photo">
        <Image
            src={profielfoto}
            alt={alt}
            width={600}
            format="webp"
            quality={85}
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
            class="portrait-image"
        />
    </div>

    {caption && (
        <figcaption>{caption}</figcaption>
    )}
</figure>

<style lang="scss">
    .portrait {
        margin: 0;
    }

    .photo {
        aspect-ratio: 4 / 5;
        background: var(--surface-subtle);
        overflow: hidden;
    }

    .portrait-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 30%;
    }

    .portrait figcaption {
        margin-top: 1rem;
        color: var(--text-secondary);
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        font-weight: 700;
    }
</style>
