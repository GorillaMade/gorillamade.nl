
---
import type { HTMLAttributes } from 'astro/types';

type OverlayVariant = 'solid' | 'gradient';

interface Props extends HTMLAttributes<'div'> {
  /** Set to false to omit the component. */
  render?: boolean;

  /** Overlay appearance. */
  variant?: OverlayVariant;

  /** Overlay strength from 0 to 100. */
  strength?: number;
}

const {
  render = true,
  variant = 'solid',
  strength = 50,
  class: className,
  style,
  ...rest
} = Astro.props;

// --------------------------------------------------
// Strength
// --------------------------------------------------

const safeStrength = Number.isFinite(strength)
  ? Math.min(100, Math.max(0, strength))
  : 50;

const opacity = safeStrength / 100;

// --------------------------------------------------
// Inline styles
// --------------------------------------------------

const overlayStyle = [
  `--overlay-opacity: ${opacity}`,
  typeof style === 'string' ? style : ''
]
  .filter(Boolean)
  .join('; ');
---

{render && (
  <div
    {...rest}
    class:list={[
      'overlay',
      `overlay--${variant}`,
      className
    ]}
    style={overlayStyle}
    aria-hidden="true"
  />
)}

<style lang="scss">
.overlay {
    // Configuration
    --overlay-opacity: 0.5;
    // Base
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    // Solid
    &--solid {
        background-color: rgb(
        0 0 0 / var(--overlay-opacity)
        );
    }
    // Gradient
    &--gradient {
        background-image: linear-gradient(
        to bottom,
        transparent 0%,
        rgb(0 0 0 / calc(var(--overlay-opacity) * 0.3)) 35%,
        rgb(0 0 0 / var(--overlay-opacity)) 100%
        );
    }
}
</style>
