---
interface Props { href?: string; }
const { href = '#main' } = Astro.props;
---
<a href={href} class="skip-link"><slot>Direct naar inhoud</slot></a>
<style lang="scss">
.skip-link:not(:focus){
    position:absolute;
    width:1px;
    height:1px;
    overflow:hidden;
    clip-path:inset(50%);
    white-space:nowrap}

.skip-link:focus{
    position:fixed;
    inset-block-start:var(--space-xs);
    inset-inline-start:var(--space-xs);
    z-index:var(--layer-top);
    padding:var(--space-xs) var(--space-s);
    background:var(--surface-page);
    color:var(--text-primary);
    border-radius:var(--radius-s)}
</style>
